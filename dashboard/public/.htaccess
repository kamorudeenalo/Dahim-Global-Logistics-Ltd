# Dahim Dashboard — SPA routing for Apache (cPanel shared hosting).
# Lives at /dashboard/ on the main WordPress domain (not a separate
# subdomain). Without this, refreshing any page other than the homepage
# (e.g. yoursite.com/dashboard/inquiries) would 404, since those paths
# only exist client-side, not as real files.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /dashboard/

  # Let real files and folders (assets, icons, manifest, service worker) through as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else goes to index.html so React Router can handle it
  RewriteRule ^ index.html [L]
</IfModule>

# Force HTTPS
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Never cache index.html (so updates roll out immediately); cache hashed assets aggressively
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    # LiteSpeed's own server-level cache engine works independently of the
    # standard Cache-Control header above — this is its documented syntax
    # for the same thing, so an old build can't get served from its cache
    # after a new one is deployed here.
    Header set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
